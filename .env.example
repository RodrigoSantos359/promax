# PromaX Connection
PROMAX_URL=https://dibrasa.promaxcloud.com.br/
PROMAX_DEFAULT_USER=SEU_USUARIO_AQUI
PROMAX_DEFAULT_PASSWORD=SUA_SENHA_AQUI

# Database
DATABASE_URL=sqlite:///data/promax.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-generate-with-cryptography.Fernet

# WebDriver
# BROWSER: "chrome" ou "edge_ie" (Edge em modo de Compatibilidade com Internet Explorer,
# necessário para telas do PromaX que usam VBScript)
BROWSER=chrome
# Deixe como está (instalado no build do Dockerfile) — vazio aqui sobrescreveria
# o ENV da imagem e faria o Selenium Manager tentar baixar o driver em runtime
# (rede externa, pode falhar/travar com a VPN em full-tunnel).
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
IEDRIVER_PATH=
EDGE_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
HEADLESS=False
WINDOW_SIZE=1920,1080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# Flask (if using web UI)
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# Scheduler
TIMEZONE=America/Sao_Paulo

# VPN corporativa (container vpn/, ver vpn/README ou CLAUDE.md)
# Credenciais (PSK, usuário/senha XAuth) NÃO vão aqui — ficam em
# ./secrets/*.txt (gitignored), lidas via Docker secrets.
#
# VPN_REMOTE_SUBNETS: rede(s) do lado da empresa que devem passar pelo túnel.
# Default 0.0.0.0/0 (full-tunnel, igual ao FortiClient) até descobrir o(s)
# subnet(s) real(is) do ProMAX interno (ver CLAUDE.md "Integração VPN").
VPN_REMOTE_SUBNETS=0.0.0.0/0
# VPN_INTERNAL_DNS: IP do DNS interno da empresa, se o ProMAX depender dele
# para resolver hostnames internos (descubra conectando 1x pelo FortiClient
# e checando `ipconfig /all` enquanto conectado). Deixe vazio se não souber.
VPN_INTERNAL_DNS=

# API BPO ACENE (envio dos relatórios originais ao BPO)
# Endereço base do servidor; vazio = envio desligado. O token é por empresa (tela de empresas).
BPO_ACENE_URL=
BPO_ACENE_VERIFY_SSL=True
# Padrão: 14.05.05 pagamentos, 12.06.04 recebimentos, 12.04.07.03 extrato,
# 16.03.08 despesas por título, 01.20.04 fornecedores, 01.20.12 clientes
# BPO_ACENE_ROTINAS=14.05.05,12.06.04,12.04.07.03,16.03.08,01.20.04,01.20.12
